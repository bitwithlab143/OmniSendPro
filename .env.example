# OmniSendPro configuration (ARCHITECTURE.md §35). Copy to .env and fill in.
# In production keep these in a secret manager, never in git.

APP_ENV=development            # production enables strict secret checks, secure cookies, HSTS, no API docs
LOG_LEVEL=INFO

# --- Database / queue (docker-compose builds DATABASE_URL from these) --------------------------------
POSTGRES_USER=omnisend
POSTGRES_PASSWORD=change-me
POSTGRES_DB=omnisend
# DATABASE_URL=postgresql+asyncpg://omnisend:change-me@localhost:5432/omnisend   # when running outside compose
# REDIS_URL=redis://localhost:6379/0

# --- Secrets (required in production) ---------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=
WORKER_JWT_SECRET=
# 32-byte AES key(s) for provider secrets, base64, versioned; the last one encrypts new data.
# python -c "import os,base64;print('v1:'+base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# --- URLs --------------------------------------------------------------------------------------------
# Public origin of the User panel; used to build unsubscribe links in emails.
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
COOKIE_SECURE=false            # true behind HTTPS (default in production)
ADMIN_API_URL=http://localhost:8081
WORKER_API_URL=http://localhost:8082

# --- Auth -------------------------------------------------------------------------------------------
ADMIN_REQUIRE_2FA=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# First SUPER_ADMIN is created on startup only if no super admin exists yet. Remove after first boot.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# --- Limits / scheduler -----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=52428800
RUN_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=5
HEALTH_INTERVAL_SECONDS=60

# --- Worker (per worker node; provision in Admin → Workers) ------------------------------------------
QUEUE_NAME=email
WORKER_ID=
WORKER_CREDENTIAL=
# WORKER_CREDENTIAL_FILE=/run/secrets/worker_credential
# WORKER_CAPACITY=80
# WORKER_MAX_CONCURRENT_JOBS=4
# SMTP_CONNECTIONS_PER_JOB=4

# --- Ports (docker-compose) -------------------------------------------------------------------------
USER_PORT=8080
ADMIN_PORT=8081
WORKER_API_PORT=8082
