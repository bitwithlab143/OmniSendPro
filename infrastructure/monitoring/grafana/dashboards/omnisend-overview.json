{
  "uid": "omnisend-overview",
  "title": "OmniSendPro overview",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "omnisend"
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Sending rate",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "omnisend_sending_rate"
        }
      ],
      "id": 1
    },
